<Window x:Class="Jolisoft.WPFTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jolisoft WPFTools — Local Dataverse queries" Height="540" Width="950">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="SDK LINQ…" Click="OpenLinq" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Retry scenarios…" Click="OpenRetryScenarios" Padding="12,6"/>
                </StackPanel>
                <TextBlock Text="Dataverse query workbench" FontSize="26"/>
            </DockPanel>
            <TextBlock Text="Local fictional records • fixed reference date: 3 October 2026 (UTC)" Margin="0,0,0,16"/>
            <WrapPanel Margin="0,0,0,16">
                <CheckBox x:Name="ActiveOnly" Content="Active records only" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="CurrentOnly" Content="Unexpired or no expiry" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="JoinOrganisation" Content="Join active organisation" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <Button Content="Run SDK query" Click="RunQuery" Padding="16,8"/>
            </WrapPanel>
            <TextBlock x:Name="QuerySummary" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="ChoiceSummary" TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,16,0,0" TextWrapping="Wrap"/>
        <DataGrid x:Name="Results" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
    </DockPanel>
</Window>
