<Window x:Class="Jolisoft.WPFTools.LinqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jolisoft WPFTools — SDK LINQ" Height="580" Width="850"
        MinHeight="460" MinWidth="700" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Typed SDK LINQ query" FontSize="26" Margin="0,0,0,12"/>
            <TextBlock Text="The SDK translates typed LINQ into QueryExpression. Join mode requires an active organisation with registration ACME-LOCAL-001."
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,12">
                <CheckBox x:Name="ActiveOnly" Content="Active only" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="CurrentOnly" Content="Unexpired or no expiry" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="JoinOrganisation" Content="Join active organisation" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <Button Content="Run SDK LINQ" Click="RunLinq" Padding="16,8"/>
            </WrapPanel>
            <TextBlock x:Name="QueryCode"
                       FontFamily="Consolas" Margin="0,0,0,12"/>
            <TextBlock Text="Optional Where clauses follow the checkboxes. Reference date: 3 October 2026 UTC. Model is handwritten for these fixtures."
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBox x:Name="RequestTrace" DockPanel.Dock="Bottom" Height="110" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,12,0,0"/>
        <DataGrid x:Name="Results" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
    </DockPanel>
</Window>
